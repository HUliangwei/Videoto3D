{
  "name": "videoto3d-gui",
  "private": true,
  "version": "1.1.2",
  "workspaces": [
    "viewer",
    "control/web"
  ],
  "scripts": {
    "dev": "npm --workspace @videoto3d/control-web run dev",
    "build": "npm --workspace @videoto3d/control-web run build",
    "typecheck": "npm --workspace @videoto3d/control-web run typecheck",
    "viewer:dev": "npm --workspace @videoto3d/viewer run demo",
    "viewer:build": "npm --workspace @videoto3d/viewer run demo:build"
  }
}
